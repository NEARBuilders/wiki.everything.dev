      "integrity": "sha384-8N+cO6oJ6Dl/wU80qYzKWdNB3UPB+D3BUChPT+XPPmeyqVTZeDMLgNJbFumCzsP7"
    },
    "wiki-media": {
      "development": "local:plugins/wiki-media",
      "production": "https://elliot-braem-5711-wiki-media-wiki-everything-dev--0374def3d-ze.zephyrcloud.app",
      "integrity": "sha384-Fj8zMV1DYddL4p43u2pTxdqU06deMHl3xZFKfwKPSHLssMILO1ezKvLR8W9fWPXo"
    }
