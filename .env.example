# Generated from configured bos secrets
# Update values as needed for your local environment

# app.host — tenant resolution (see TENANCY.md)
CORS_ORIGIN=http://localhost:3000
# Comma-separated tenant account IDs (supports *.domain.near wildcards)
TENANT_WHITELIST=
# Comma-separated override targets: ui, plugins.*, plugins.<key>
ALLOW_OVERRIDE=
# Allow any tenant to SSR without whitelist (true/false)
ALLOW_UNTRUSTED_SSR=
CSP_STRICT=

# app.api
API_DATABASE_URL=postgres://everythingdev:everythingdev@localhost:5432/api_db

# app.auth
AUTH_DATABASE_URL=postgres://everythingdev:everythingdev@localhost:5433/auth_db
BETTER_AUTH_SECRET=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
FASTNEAR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
# Wiki tenant creation (see TENANCY.md "Env Configuration")
# Required by the auth plugin SIWN subaccount creation flow
NEAR_RELAYER_PRIVATE_KEY=ed25519:...
# Parent key for creating wiki sub-accounts on mainnet (e.g., starwars.wiki.everything.near)
NEAR_SUB_ACCOUNT_PARENT_KEY_MAINNET=ed25519:...
# Parent key for creating wiki sub-accounts on testnet
NEAR_SUB_ACCOUNT_PARENT_KEY_TESTNET=ed25519:...

